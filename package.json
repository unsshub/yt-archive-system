{
  "name": "yt-archive-system",
  "version": "1.0.0",
  "description": "Production-ready web app to save YouTube video metadata, store in GitHub repo, and search in English or Arabic",
  "main": "src/js/app.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"public/**/*.html\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\" \"public/**/*.html\"",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rm -rf dist coverage node_modules/.cache"
  },
  "keywords": [
    "youtube",
    "archive",
    "offline",
    "github-sync",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.2.0",
    "prettier": "^3.2.0",
    "vite": "^5.0.0",
    "terser": "^5.27.0"
  }
}