{
  "env": {
    "browser": true,
    "node": true,
    "jest": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "allowImportExportEverywhere": true
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-undef": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always"],
    "curly": ["warn", "multi-line"],
    "semi": ["error", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "indent": ["warn", 2, { "SwitchCase": 1 }],
    "comma-dangle": ["warn", "only-multiline"],
    "no-multiple-empty-lines": ["warn", { "max": 1 }],
    "no-trailing-spaces": "warn",
    "eol-last": ["warn", "always"]
  },
  "globals": {
    "global": "readonly",
    "module": "readonly",
    "require": "readonly",
    "Buffer": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly",
    "setInterval": "readonly",
    "clearInterval": "readonly",
    "Promise": "readonly",
    "fetch": "readonly",
    "navigator": "readonly",
    "window": "readonly",
    "document": "readonly",
    "console": "readonly",
    "CustomEvent": "readonly",
    "Map": "readonly",
    "TextEncoder": "readonly",
    "TextDecoder": "readonly",
    "btoa": "readonly",
    "localStorage": "readonly",
    "sessionStorage": "readonly",
    "URL": "readonly",
    "URLSearchParams": "readonly",
    "Blob": "readonly",
    "FileReader": "readonly",
    "requestAnimationFrame": "readonly",
    "cancelAnimationFrame": "readonly",
    "addEventListener": "readonly",
    "removeEventListener": "readonly",
    "dispatchEvent": "readonly",
    "Event": "readonly",
    "KeyboardEvent": "readonly",
    "MouseEvent": "readonly",
    "Error": "readonly",
    "TypeError": "readonly",
    "JSON": "readonly",
    "Math": "readonly",
    "Date": "readonly",
    "RegExp": "readonly",
    "Array": "readonly",
    "Object": "readonly",
    "String": "readonly",
    "Number": "readonly",
    "Boolean": "readonly",
    "parseInt": "readonly",
    "parseFloat": "readonly",
    "isNaN": "readonly",
    "isFinite": "readonly",
    "undefined": "readonly",
    "null": "readonly",
    "Intl": "readonly",
    "Intl": "readonly"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/",
    "*.min.js"
  ]
}